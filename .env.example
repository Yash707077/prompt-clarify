# Copy this file to .env and put your real key in it.
# .env is git-ignored, so your key never leaves your computer.
#
#   cp .env.example .env
#   then edit .env and paste your key
#
# Get a free key at: https://aistudio.google.com/apikey
# Keep billing OFF on that Google Cloud project, or the free tier is lost.

GEMINI_API_KEY=paste_your_key_here

# Optional. Leave this out unless you have a reason to change it.
# Default is gemini-flash-lite-latest — the highest free-tier quota.
# GEMINI_MODEL=gemini-flash-latest
