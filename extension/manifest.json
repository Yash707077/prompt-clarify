{
  "manifest_version": 3,
  "name": "prompt-clarify",
  "version": "0.1.0",
  "description": "Ask once. Remember forever. Improves your prompt using what it already knows about you.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*.workers.dev/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "prompt-clarify settings",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["config.js", "prompt.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
