{
  "name": "prompt-clarify",
  "version": "0.1.2",
  "description": "Prompting tool with memory. Ask once, remember forever.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prompt-clarify": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "models": "tsx src/models.ts",
    "testrun": "tsx src/testrun.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "echo \"No unit tests yet — see test-prompts.txt for the manual suite\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yash707077/prompt-clarify.git"
  },
  "keywords": [
    "prompt",
    "prompt-engineering",
    "prompt-improvement",
    "cli",
    "llm",
    "gemini",
    "ai"
  ],
  "author": "yash raj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Yash707077/prompt-clarify/issues"
  },
  "homepage": "https://github.com/Yash707077/prompt-clarify#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "dotenv": "^17.4.2"
  }
}
